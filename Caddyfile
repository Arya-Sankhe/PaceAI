{$DOMAIN:localhost} {
	reverse_proxy /health/live api:8000
	reverse_proxy /health/ready api:8000
	reverse_proxy /api/* api:8000
	reverse_proxy web:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' https: blob: data:; media-src 'self' blob:; connect-src 'self' https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
	}
}
