# Compose defaults to the generated dummy cockpit so a clean checkout is useful immediately.
DEMO_MODE=true
MOCK_FAULT=hor_front_temp
MOCK_FAULT_MACHINE=orion_1
DOMAIN=localhost

# Required only when DEMO_MODE=false.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Backend values are required for manual ingestion/chat. Start the worker with:
# docker compose --profile rag up -d
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
GEMINI_API_KEY=replace-me
# Optional: flex halves GenerateContent cost (diagnosis + page profiling) at
# slower best-effort latency. Embeddings are unaffected. Default standard.
GEMINI_SERVICE_TIER=standard
