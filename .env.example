# Compose defaults to the generated dummy cockpit so a clean checkout is useful immediately.
DEMO_MODE=true
MOCK_FAULT=hor_front_temp
MOCK_FAULT_MACHINE=orion_1
DOMAIN=localhost

# Required only when DEMO_MODE=false.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# JWT validation for API and speech calls (required when DEMO_MODE=false).
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Backend values are required for manual ingestion/chat. Start the worker with:
# docker compose --profile rag up -d
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
GEMINI_API_KEY=replace-me
# Optional: flex halves GenerateContent cost (diagnosis + page profiling) at
# slower best-effort latency. Embeddings are unaffected. Default standard.
GEMINI_SERVICE_TIER=standard

# Sarvam speech (voice mode). Get a key at https://dashboard.sarvam.ai/.
# STT "auto" detects the spoken language per utterance (22 Indian languages).
# Answers are spoken back in their own language where Bulbul supports it (11
# languages); other answers stay text-only. The TTS language and speaker are
# only fallbacks for text with no language of its own.
SARVAM_API_KEY=replace-me
SARVAM_STT_LANGUAGE=auto
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SPEAKER=shubh
