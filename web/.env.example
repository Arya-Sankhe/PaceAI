# Browser env (public anon key only — never a service key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# true runs the generated snapshot demo; set false to use FastAPI telemetry/auth
NEXT_PUBLIC_DEMO_MODE=true
# Server-side rewrite target for /api/* (compose sets http://api:8000)
BACKEND_URL=http://localhost:8000
