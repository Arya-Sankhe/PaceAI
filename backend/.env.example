# =============================================================================
# Orion AI Copilot — Environment Variables
# =============================================================================

ENVIRONMENT=development
DEBUG=true

# ─── Supabase Configuration ──────────────────────────────────────────────────
# Found in your Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Optional direct Postgres URI for asyncpg connection pooling:
# postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_DB_URL=

SUPABASE_STORAGE_BUCKET_MANUALS=manual-documents
SUPABASE_STORAGE_BUCKET_PAGES=manual-pages

# ─── Google AI / Gemini & Vertex API ──────────────────────────────────────────
# For Gemini LLM Reasoning (Google AI Studio or Vertex AI)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_PROFILER_MODEL=gemini-2.5-flash
GEMINI_DIAGNOSTIC_MODEL=gemini-2.5-pro

# For Google Cloud Multimodal Embeddings (multimodalembedding@002)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_MULTIMODAL_EMBEDDING_MODEL=multimodalembedding@002

# ─── Industrial Telemetry & OPC UA Settings ──────────────────────────────────
TELEMETRY_POLL_INTERVAL_SECONDS=1.0
TELEMETRY_BATCH_FLUSH_SECONDS=3.0
# Set to true if testing without physical connection to 192.168.213.1 B&R PLC:
OFFLINE_MOCK_TELEMETRY=false

# Industrial OPC UA Security (Default is None for direct factory intranet)
OPC_UA_SECURITY_POLICY=None
OPC_UA_USERNAME=
OPC_UA_PASSWORD=
OPC_UA_TIMEOUT_SECONDS=5.0
