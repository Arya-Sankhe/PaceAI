# =============================================================================
# Orion AI Copilot — Environment Variables (v0.5 MVP Baseline)
# =============================================================================

ENVIRONMENT=development
DEBUG=true

# ─── Supabase Configuration ──────────────────────────────────────────────────
# Found in Supabase Dashboard -> Settings -> API / Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:your-db-pass@db.your-project-ref.supabase.co:5432/postgres

SUPABASE_STORAGE_BUCKET_MANUALS=manual-documents
SUPABASE_STORAGE_BUCKET_PAGES=manual-pages

# Optional JWT validation for authenticated UI callers
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_JWKS_URL=

# ─── Google Gemini API ───────────────────────────────────────────────────────
# Single API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
# Service tier for all GenerateContent calls (diagnosis + page profiling):
# standard (default) or flex (50% off, slower best-effort latency, no fallback).
# Embeddings are unaffected — embedContent has no tier.
GEMINI_SERVICE_TIER=standard
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1536

# ─── Storage Signed URL TTL ──────────────────────────────────────────────────
SIGNED_URL_EXPIRY_SECONDS=300

# ─── Sarvam Speech (voice mode) ──────────────────────────────────────────────
# Key from https://dashboard.sarvam.ai/. STT "auto" detects the spoken language
# per utterance; pin a code like "hi-IN" to force one. The TTS language and
# speaker are only fallbacks — each answer brings its own language code.
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_STT_LANGUAGE=auto
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SPEAKER=shubh
